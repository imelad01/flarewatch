{
  "name": "flarewatch",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "compile": "vp check --no-fmt --no-lint",
    "check": "vp check",
    "auth:secret": "node --experimental-strip-types scripts/generate-auth-secret.ts",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "lint": "vp lint",
    "sync:upstream": "powershell -ExecutionPolicy Bypass -File scripts/sync-upstream.ps1",
    "deploy:worker": "vp exec --filter worker -- wrangler deploy",
    "deploy:status-page": "vp run --filter status-page build && vp exec --filter status-page -- wrangler deploy --config dist/server/wrangler.json",
    "deploy:all": "pnpm deploy:worker && pnpm deploy:status-page"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
